    </Content>
    <Content Include="Servicos\icone\ATTRIBUTION.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Configuracoes REAIS: copiadas para o bin (execucao local no dev), porem NUNCA para o publish.
         Assim o pacote de atualizacao NAO sobrescreve os configuracao.*.json da maquina do usuario. -->
    <Content Include="configuracao.banco.json" Condition="Exists('configuracao.banco.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Include="configuracao.terminal.json" Condition="Exists('configuracao.terminal.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <None Update="configuracao.sap.json" Condition="Exists('configuracao.sap.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>

    <!-- MODELOS (.exemplo.json): vao para o publish como referencia para a 1a configuracao da maquina.
         Nunca contem segredo; o operador copia para configuracao.*.json e preenche uma unica vez. -->
    <Content Include="configuracao.banco.exemplo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="configuracao.terminal.exemplo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Include="configuracao.sap.exemplo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Permite que o projeto de testes exercite tipos internal (ex.: helpers de Tela.Comum). -->
    <InternalsVisibleTo Include="FugaPET_HML.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Servicos\Auditoria\" />
    <Folder Include="Servicos\IntegracaoSap\" />
    <Folder Include="Servicos\Balanca\" />
    <Folder Include="Servicos\Zebra\" />
    <Folder Include="Servicos\Status\" />
  </ItemGroup>

</Project>


